{
  "name": "acento",
  "version": "0.1.0",
  "private": true,
  "description": "A production-grade Spanish learning platform for real regional Spanish, starting with Dominican Spanish.",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspace @acento/web",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present && npm run test:api",
    "test:api": "mvn -f apps/api/pom.xml test",
    "content:check": "tsx scripts/check-content.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "husky": "^9.1.7",
    "prettier": "^3.6.2",
    "tsx": "^4.20.6"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  }
}
